# 自治体Watch — npm設定
# 位置づけ: docs/lessons-learned.md「npm installのpeer dependency警告」節の方針を反映。
# --legacy-peer-deps はここに恒久化しない（競合の隠蔽になるため）。
# 競合が出た場合はまずバージョンピンで解決を試みること。

# Node.jsバージョンが.nvmrc/package.jsonのenginesと一致しない場合にエラーにする
engine-strict=true

# インストール時にsemverレンジ（^等）でなく厳密バージョンをpackage.jsonに記録する
# （将来の依存関係の競合を予防し、バージョンピンでの解決を徹底する）
save-exact=true
